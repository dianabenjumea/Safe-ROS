GWENDOLEN

:name: agilex_agent

:Initial Beliefs:
mode(normal)                         // The agent starts in its normal operational mode


:Initial Goals:

:Plans:

+too_close : { B mode(normal) } <- 
    +.lock,                         // prevent concurrent recovery
    stop_moving,            
    -mode(normal),                  
    +mode(recovery),
    +stopped,
    -.lock; 

+stopped : { B mode(recovery) } <- 
    +.lock,
    return_to_start,
    -stopped,
    -mode(recovery),
    +mode(normal),
    -.lock; 




