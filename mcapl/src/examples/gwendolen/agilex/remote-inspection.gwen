GWENDOLEN

:name: agilex_agent

:Initial Beliefs:
mode(normal)

location_coordinate(0,door,0.0,0.0,0.0)
location_coordinate(1,inspectionPoint1,2.3,-1.11,0.0)
location_coordinate(2,inspectionPoint2,-3,-1.5,0.0)
location_coordinate(3,inspectionPoint3,2.61,2.43,0.0)

next_location(0,1)
next_location(1,2)
next_location(2,3)

