GWENDOLEN

:name: agilex_agent

:Initial Beliefs:
mode(normal)

:Initial Goals:

:Plans:

+too_close : { B mode(normal) } <- 
    print("Obstacle detected too close!"),
    stop_moving,
    -mode(normal),
    +mode(recovery),
    +stopped;

+stopped : { B mode(recovery) } <- 
    print("Returning to start position"),
    return_to_start,
    -stopped,
    -mode(recovery),
    +mode(normal);

