GWENDOLEN

:name: agilex_agent

:Initial Beliefs:

mode(normal)
next_location(0,1)
next_location(1,2)
next_location(2,3)
going(1)
safe(0)

:Initial Goals:


:Plans:

+too_close : { B mode(normal), B going(WP) } <-
    +.lock,
    print("Too Close Received"),
    stop_moving,
    -safe(WP),
    -mode(normal),
    +mode(recovery),
    -.lock;


+mode(recovery) : { B going(L1), B next_location(L2, L1), B safe(L2)} <-
    -going(L1),
    +going(L2),
    print("Recovery Mode"),
    moveTo(L2);


+at(L1) : { B going(L1), B next_location(L1,L2), B mode(normal) } <-
    -going(L1),
    print("Movement to location "),
    print(L1),
    print(" ended with success."),
    +safe(L1),
    +going(L2);


+at(L1) : { B going(L1), B next_location(L2,L1),
B mode(recovery)} <-
    -going(L1),
    print("Movement to location "),
    print(L1),
    print(" ended with success."),
    +safe(L1),
    +going(L2),
    moveTo(L2) ;





